# Python
backend/.venv/
__pycache__/
*.pyc

# Environment files — never commit secrets
.env
.env.*
*.env

# Runtime state — never commit balances, keys, or local config drift.
# config.yaml holds API keys; config.runtime.yaml is machine state
# written by the app. example.config.yaml stays tracked as the template.
backend/olala.db
backend/olala.db-shm
backend/olala.db-wal
backend/keystore.enc
backend/config.yaml
backend/config.runtime.yaml

